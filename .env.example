# Local values come from `pnpm db:start` / `pnpm supabase status`.
# Production values: Supabase dashboard > Project Settings > API (set in the hosting provider).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google OAuth client (local dev); read by `pnpm db:start` for supabase/config.toml.
# Redirect URI: http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

